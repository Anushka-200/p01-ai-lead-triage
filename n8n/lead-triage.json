    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Twin of LeadCard validation + fill_from_form. No repair loop here: a bad answer fails the run\n// (the error workflow will report it) - one of the honest differences from the Python version.\nconst tool = ($json.content || []).find((c) => c.type === 'tool_use');\nif (!tool) throw new Error('Claude did not fill the record_lead form');\nconst card = tool.input;\n\nconst CATEGORIES = ['new_lead', 'support', 'refund_complaint', 'spam', 'other'];\nif (!CATEGORIES.includes(card.category)) throw new Error(`bad category: ${card.category}`);\nif (!Number.isInteger(card.priority) || card.priority < 1 || card.priority > 5)\n  throw new Error(`bad priority: ${card.priority}`);\n\nconst form = $('Fingerprint').item.json;   // the original form, from node 5\nreturn { json: {\n  ...card,\n  name: card.name ?? form.name ?? null,\n  email: card.email ?? form.email ?? null,\n  company: card.company ?? null,\n  received_at: form.received_at,\n  message_id: $execution.id,             // n8n's run number stands in for our database id\n} };"
      },
