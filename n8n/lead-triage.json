      "parameters": {
        "jsCode": "// Same rule as app/signing.py: HMAC-SHA256 of \"<timestamp>.<raw body>\" with the shared secret\nconst crypto = require('crypto');\n\nconst headers = $input.first().json.headers;\nconst timestamp = headers['x-timestamp'] || '';\nconst signature = headers['x-signature'] || '';\nconst secret = $env.WEBHOOK_SHARED_SECRET;\n\n// The exact bytes the sender signed (the Raw Body option keeps them untouched)\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\n\n// 1. Fresh? Reject anything more than 5 minutes old or in the future (replay protection)\nconst age = Math.abs(Date.now() / 1000 - Number(timestamp));\nconst fresh = Number.isFinite(age) && age <= 300;\n\n// 2. Recompute the stamp ourselves\nconst expected = secret\n  ? crypto.createHmac('sha256', secret)\n      .update(Buffer.concat([Buffer.from(timestamp + '.'), raw]))\n      .digest('hex')\n  : '';\n\n// 3. Compare in constant time, so an attacker can't learn it character by character\nconst matches = expected !== '' && signature.length === expected.length &&\n  crypto.timingSafeEqual(Buffer.from(signature), Buffer.from(expected));\n\n// 4. Read the form (name, email, message) only if it's valid JSON\nlet form = null;\ntry { form = JSON.parse(raw.toString('utf8')); } catch (e) {}\n\nreturn [{ json: { valid: fresh && matches && form !== null, form } }];"
      },
