    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\n// Same idea as app/dedupe.py: tidy the text, then hash sender + message\nconst crypto = require('crypto');\nconst normalize = (t) => String(t ?? '').trim().toLowerCase().replace(/\\s+/g, ' ');\n\nconst form = $json.form;\nconst fingerprint = crypto.createHash('sha256')\n  .update(JSON.stringify([normalize(form.email), normalize(form.message)]))\n  .digest('hex');\n\nreturn { json: { ...form, fingerprint, received_at: new Date().toISOString() } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
